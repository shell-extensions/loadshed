import time
from contextlib import contextmanager

CONFIG_DIR = "/etc/loadshed"
CONFIG_PATH = f"{CONFIG_DIR}/units.json"
RUNTIME_DIR = "/run/loadshed"
STATE_DIR = "/var/lib/loadshed"
STATE_PATH = f"{STATE_DIR}/state.json"
LEGACY_STATE_PATH = f"{RUNTIME_DIR}/state.json"
LOCK_PATH = f"{RUNTIME_DIR}/helper.lock"
GATE_SOCKET_PATH = f"{RUNTIME_DIR}/gate.sock"
CGROUP_ROOT = "/sys/fs/cgroup"
GATE_TIMEOUT = 3.0
STATE_VERSION = 2
BOOT_ID_PATH = "/proc/sys/kernel/random/boot_id"

# Legacy process names are accepted only as a migration input.  Resolution is
# deliberately independent of PATH so a user-controlled environment cannot
# select the executable that receives an execution permission mark.
LEGACY_EXECUTABLE_DIRS = ("/usr/bin", "/bin", "/usr/sbin", "/sbin")
LEGACY_CANONICAL_PATHS = {
    "rsync": "/usr/bin/rsync",
}

VALID_ID_RE = re.compile(r"^[A-Za-z0-9_.@:-]+$")
VALID_UNIT_RE = re.compile(r"^[A-Za-z0-9_.@:\\-]+\.(service|timer)$")
VALID_PROCESS_RE = re.compile(r"^[A-Za-z0-9_.@:+-]+$")


class LoadshedError(Exception):
    pass


def default_state():
    return {
        "version": STATE_VERSION,
        "intent": "idle",
        "paused": False,
        "generation": 0,
        "entries": {},
        "gate": {},
        "recovery_required": False,
        "state_known": True,
        "state_error": None,
        "state_present": False,
    }


def current_boot_id():
    try:
        with open(BOOT_ID_PATH, "r", encoding="utf-8") as boot_file:
            return boot_file.read().strip()
    except OSError:
        return None


@contextmanager
def helper_lock(shared=False):
    """Serialize helper transitions so pause/resume cannot cross each other."""
    os.makedirs(RUNTIME_DIR, mode=0o755, exist_ok=True)
    fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            os.chown(LOCK_PATH, 0, 0)
            os.chmod(LOCK_PATH, 0o600)
        except OSError:
            pass
        fcntl.flock(fd, fcntl.LOCK_SH if shared else fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def json_print(payload):
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))


def fail(message, action="error"):
    json_print({
        "ok": False,
        "action": action,
        "paused": False,
        "pause_intent": False,
        "pause_state_known": False,
        "gate_healthy": False,
        "gate_active": False,
        "queued_exec_count": 0,
        "protected_count": 0,
        "external_frozen_count": 0,
        "recovery_required": True,
        "resume_pending": False,
        "state_error": message,
        "error": message,
        "entries": [],
        "errors": [message],
    })
    return 1


def require_root():
    if os.geteuid() != 0:
        raise LoadshedError("loadshed-helper must run as root")


def require_systemctl():
    if shutil.which("systemctl") is None:
        raise LoadshedError("systemctl was not found")


def validate_unit_name(unit, suffix):
    if not isinstance(unit, str) or not VALID_UNIT_RE.match(unit):
        raise LoadshedError(f"invalid unit name: {unit!r}")
    if not unit.endswith(suffix):
        raise LoadshedError(f"expected a {suffix} unit: {unit}")
    return unit


def normalize_executable_path(executable, require_exists=False):
    if not isinstance(executable, str) or not executable.startswith("/"):
        raise LoadshedError(f"executable must be an absolute path: {executable!r}")
    if "\x00" in executable:
        raise LoadshedError("executable path contains NUL")

    path = os.path.normpath(executable)
    if require_exists:
        try:
            st = os.stat(path)
        except OSError as exc:
            raise LoadshedError(f"executable not found: {path}") from exc
        if not stat.S_ISREG(st.st_mode) or not os.access(path, os.X_OK):
            raise LoadshedError(f"executable is not an executable regular file: {path}")

    # Resolve symlinks when the file exists so the gate and /proc identity
    # refer to the same inode.  Keep a normalized absolute path for an absent
    # target; require_exists=True already rejected it above unless the
    # caller treats a missing optional target as "skip" instead of an error
    # (see gate_targets()).
    return os.path.realpath(path) if os.path.exists(path) else path


def resolve_legacy_process(process):
    if not isinstance(process, str) or not VALID_PROCESS_RE.match(process):
        raise LoadshedError(f"invalid legacy process name: {process!r}")

    candidates = []
    for directory in LEGACY_EXECUTABLE_DIRS:
        path = os.path.join(directory, process)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            canonical = normalize_executable_path(path, require_exists=True)
            if canonical not in candidates:
                candidates.append(canonical)

    if len(candidates) > 1:
        raise LoadshedError(
            f"legacy process {process!r} is ambiguous; configure an absolute executable path"
        )
    if candidates:
        return candidates[0]

    canonical = LEGACY_CANONICAL_PATHS.get(process)
    if canonical:
        return normalize_executable_path(canonical, require_exists=True)

    raise LoadshedError(
        f"legacy process {process!r} has no executable in fixed system paths; "
        "configure an absolute executable path"
    )


def validate_entry(raw, index):
    if not isinstance(raw, dict):
        raise LoadshedError(f"unit entry #{index + 1} is not an object")

    entry_id = raw.get("id")
    label = raw.get("label")
    service = raw.get("service")
    timer = raw.get("timer")
    process = raw.get("process")
    executable = raw.get("executable")
    optional = raw.get("optional", False)
    enabled = raw.get("enabled", True)

    if not isinstance(entry_id, str) or not VALID_ID_RE.match(entry_id.strip()):
        raise LoadshedError(f"invalid id in unit entry #{index + 1}")
    if not isinstance(label, str) or not label.strip():
        raise LoadshedError(f"invalid label in unit entry {entry_id}")
    if service is not None and not isinstance(service, str):
        raise LoadshedError(f"invalid service in unit entry {entry_id}")
    if process is not None and not isinstance(process, str):
        raise LoadshedError(f"invalid process in unit entry {entry_id}")
    if executable is not None and not isinstance(executable, str):
        raise LoadshedError(f"invalid executable in unit entry {entry_id}")
    if not isinstance(optional, bool):
        raise LoadshedError(f"invalid optional flag in unit entry {entry_id}")
    if not isinstance(enabled, bool):
        raise LoadshedError(f"invalid enabled flag in unit entry {entry_id}")

    entry_id = entry_id.strip()
    if service is not None:
        service = service.strip() or None
    if process is not None:
        process = process.strip() or None
    if executable is not None:
        executable = executable.strip() or None
    if not service and not process and not executable:
        raise LoadshedError(f"unit entry {entry_id} needs a service or executable")
    if service and (process or executable):
        raise LoadshedError(f"unit entry {entry_id} cannot mix a service and executable")
    if process and executable:
        raise LoadshedError(f"unit entry {entry_id} cannot mix process and executable")

    if service:
        service = validate_unit_name(service, ".service")
    if process and not VALID_PROCESS_RE.match(process):
        raise LoadshedError(f"invalid process name in unit entry {entry_id}: {process!r}")
    if process:
        executable = resolve_legacy_process(process)
    if executable:
        executable = normalize_executable_path(executable)
    if isinstance(timer, str):
        timer = timer.strip() or None
    if timer is not None:
        if not service:
            raise LoadshedError(f"process entry {entry_id} cannot use a timer")
        timer = validate_unit_name(timer, ".timer")

    entry = {
        "id": entry_id,
        "label": label.strip(),
        "optional": optional,
        "enabled": enabled,
    }
    if service:
        entry["service"] = service
        entry["timer"] = timer
    else:
        entry["executable"] = executable
    return entry


def validate_units(raw_units):
    if not isinstance(raw_units, list):
        raise LoadshedError("configuration root must be a JSON list")

    units = [validate_entry(raw, index) for index, raw in enumerate(raw_units)]
    seen_ids = set()
    seen_targets = set()
    for unit in units:
        if unit["id"] in seen_ids:
            raise LoadshedError(f"duplicate unit id: {unit['id']}")
        target = target_key(unit)
        if target in seen_targets:
            raise LoadshedError(f"duplicate target: {target[1]}")
        seen_ids.add(unit["id"])
        seen_targets.add(target)
    return units


def target_key(unit):
    if unit.get("service"):
        return ("service", unit["service"])
    return ("executable", unit["executable"])


def load_units():
    try:
        st = os.stat(CONFIG_PATH)
    except FileNotFoundError as exc:
        raise LoadshedError(f"configuration missing: {CONFIG_PATH}") from exc

    if st.st_uid != 0:
        raise LoadshedError(f"configuration must be owned by root: {CONFIG_PATH}")
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise LoadshedError(f"configuration must not be group/world writable: {CONFIG_PATH}")

    with open(CONFIG_PATH, "r", encoding="utf-8") as config_file:
        raw_units = json.load(config_file)

    units = validate_units(raw_units)
    migrated = any(
        isinstance(raw, dict) and "process" in raw and "executable" not in raw
        for raw in raw_units
    )
    if migrated:
        save_units_config(units)
    return units


def serialize_units(units):
    result = []
    for unit in units:
        entry = {
            "id": unit["id"],
            "label": unit["label"],
        }
        if unit.get("service"):
            entry["service"] = unit["service"]
        else:
            entry["executable"] = unit["executable"]
        if unit.get("timer"):
            entry["timer"] = unit["timer"]
        if unit.get("optional"):
            entry["optional"] = True
        if unit.get("enabled") is False:
            entry["enabled"] = False
        result.append(entry)
    return result


def save_units_config(units):
    os.makedirs(CONFIG_DIR, mode=0o755, exist_ok=True)
    tmp_path = f"{CONFIG_PATH}.tmp.{os.getpid()}"
    with open(tmp_path, "w", encoding="utf-8") as config_file:
        json.dump(serialize_units(units), config_file, indent=2, sort_keys=True)
        config_file.write("\n")
    os.chown(tmp_path, 0, 0)
    os.chmod(tmp_path, 0o644)
    os.replace(tmp_path, CONFIG_PATH)


def config_payload(action, units):
    return {
        "ok": True,
        "action": action,
        "entries": serialize_units(units),
        "errors": [],
    }


def unit_enabled(unit):
    return unit.get("enabled", True) is not False


def enabled_units(units):
    return [unit for unit in units if unit_enabled(unit)]


def _read_state_file(path):
    try:
        st = os.stat(path)
    except FileNotFoundError:
        return None

    if st.st_uid != 0 or (st.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
        raise LoadshedError(f"state must be root-owned and not group/world writable: {path}")

    try:
        with open(path, "r", encoding="utf-8") as state_file:
            state = json.load(state_file)
    except (OSError, json.JSONDecodeError) as exc:
        raise LoadshedError(f"state is unreadable or invalid: {path}") from exc
    if not isinstance(state, dict):
        raise LoadshedError(f"state root must be an object: {path}")
    return state


def _normalize_state(raw):
    state = default_state()
    if raw is None:
        return state
    if not isinstance(raw, dict):
        raise LoadshedError("state root must be an object")

    generation = raw.get("generation", 0)
    if not isinstance(generation, int) or generation < 0:
        raise LoadshedError("state generation is invalid")
    entries = raw.get("entries", {})
    if not isinstance(entries, dict):
        raise LoadshedError("state entries must be an object")

    intent = raw.get("intent")
    if intent not in {"idle", "pausing", "paused", "resuming"}:
        intent = "paused" if raw.get("paused") is True else "idle"
    version = raw.get("version", 1)
    if version not in {1, STATE_VERSION}:
        raise LoadshedError(f"unsupported state version: {version!r}")
    state.update({
        "version": STATE_VERSION,
        "intent": intent,
        "paused": raw.get("paused") is True or intent in {"pausing", "paused", "resuming"},
        "generation": generation,
        "entries": entries,
        "gate": raw.get("gate") if isinstance(raw.get("gate"), dict) else {},
        "recovery_required": bool(raw.get("recovery_required")),
        "state_present": True,
    })
    stored_boot_id = raw.get("boot_id")
    boot_id = current_boot_id()
    if stored_boot_id and boot_id and stored_boot_id != boot_id:
        # cgroup freezes, SIGSTOP state, fanotify marks, and queued execs do
        # not survive a full reboot.  Do not carry a stale pause intent into
        # a new boot; the extension will see a clean, resumable state.
        state.update({
            "intent": "idle",
            "paused": False,
            "entries": {},
            "gate": {},
            "recovery_required": False,
        })
    state["boot_id"] = boot_id or stored_boot_id
    return state


def load_state():
    """Load the durable state without turning corruption into a clean resume."""
    try:
        raw = _read_state_file(STATE_PATH)
        if raw is None and LEGACY_STATE_PATH != STATE_PATH:
            # The old release kept the state in /run.  Read it for one
            # transition so an upgrade can finish an interrupted pause/resume
            # safely.  The next save_state() writes the durable copy under
            # /var/lib.
            raw = _read_state_file(LEGACY_STATE_PATH)
        return _normalize_state(raw)
    except LoadshedError as exc:
        state = default_state()
        state["state_known"] = False
        state["state_error"] = str(exc)
        state["recovery_required"] = True
        return state


def save_state(state):
    normalized = _normalize_state(state)
    normalized["boot_id"] = normalized.get("boot_id") or current_boot_id()
    normalized["state_present"] = True
    normalized["updated_at"] = int(time.time())
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    try:
        os.chown(STATE_DIR, 0, 0)
        os.chmod(STATE_DIR, 0o700)
    except OSError:
        pass

    tmp_path = f"{STATE_PATH}.tmp.{os.getpid()}"
    with open(tmp_path, "w", encoding="utf-8") as state_file:
        json.dump(normalized, state_file, sort_keys=True, separators=(",", ":"))
        state_file.write("\n")
        state_file.flush()
        os.fsync(state_file.fileno())
    os.chown(tmp_path, 0, 0)
    os.chmod(tmp_path, 0o600)
    os.replace(tmp_path, STATE_PATH)
    try:
        directory_fd = os.open(STATE_DIR, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError:
        pass


def gate_request(command, **fields):
    request = {"command": command, **fields}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(GATE_TIMEOUT)
            client.connect(GATE_SOCKET_PATH)
            client.sendall((json.dumps(request, separators=(",", ":")) + "\n").encode())
            response = b""
            while not response.endswith(b"\n"):
                chunk = client.recv(65536)
                if not chunk:
                    break
                response += chunk
    except OSError as exc:
        raise LoadshedError(f"loadshed-gate is not reachable: {exc}") from exc

    if not response:
        raise LoadshedError("loadshed-gate returned no response")
    try:
        payload = json.loads(response.decode())
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise LoadshedError("loadshed-gate returned invalid JSON") from exc
    if not isinstance(payload, dict) or not payload.get("ok"):
        message = payload.get("error") if isinstance(payload, dict) else None
        raise LoadshedError(message or "loadshed-gate rejected the request")
    return payload


def gate_targets(units):
    targets = []
    for unit in units:
        executable = unit.get("executable")
        if not executable:
            continue
        try:
            executable = normalize_executable_path(executable, require_exists=True)
        except LoadshedError:
            if unit.get("optional"):
                continue
            raise
        targets.append({"id": unit["id"], "executable": executable})
    return targets


def gate_configure(units, generation):
    targets = gate_targets(units)
    response = gate_request(
        "configure",
        paused=True,
        generation=generation,
        targets=targets,
    )
    if not response.get("active") or not response.get("healthy", True):
        raise LoadshedError("loadshed-gate did not confirm active execution marks")
    return response


def gate_release(generation):
    response = gate_request("release", generation=generation)
    if response.get("active"):
        raise LoadshedError("loadshed-gate did not confirm release")
    # A gate may have become unhealthy while it was active (for example after
    # a target disappeared).  release() still drops active protection and
    # answers all queued permission events before returning active=false.  Do
    # not leave the helper's pause intent permanently stuck just because the
    # gate also reports the earlier fault; status will continue to expose that
    # fault after the state has been cleaned up.
    return response


def gate_status():
    try:
        response = gate_request("status")
        return {
            "healthy": bool(response.get("healthy", True)),
            "active": bool(response.get("active")),
            "queued_exec_count": int(response.get("queued_exec_count", 0)),
            "generation": response.get("generation"),
            "targets": response.get("targets", []),
            "error": response.get("error"),
        }
    except (LoadshedError, ValueError, TypeError) as exc:
        # A malformed gate response (unexpected type for queued_exec_count,
        # for example) must degrade to the same "gate unhealthy" shape as a
        # LoadshedError, not crash the caller.
        return {
            "healthy": False,
            "active": False,
            "queued_exec_count": 0,
            "generation": None,
            "targets": [],
            "error": str(exc),
        }


def systemctl(args, check=False):
    result = subprocess.run(
        ["systemctl", *args],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise LoadshedError(f"systemctl {' '.join(args)} failed: {detail}")
    return result


def show_unit(unit, include_freezer=False, extra_properties=None):
    properties = ["LoadState", "ActiveState", "SubState"]
    if include_freezer:
        properties.append("FreezerState")
    if extra_properties:
        properties.extend(extra_properties)

    args = ["show", unit, "--no-pager"]
    for prop in properties:
        args.append(f"--property={prop}")

    result = systemctl(args)
    values = {prop: "unknown" for prop in properties}
    if result.returncode != 0:
        values["Error"] = result.stderr.strip() or result.stdout.strip()
        return values

    for line in result.stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key in values:
            values[key] = value or "unknown"
    return values


def is_active(unit):
    return show_unit(unit)["ActiveState"] in ("active", "activating")


def unit_loaded(status):
    return status.get("LoadState") == "loaded"


def optional_service_missing(unit, managed_state=None):
    if not unit.get("service") or not unit.get("optional") or managed_state:
        return False
    return not unit_loaded(show_unit(unit["service"]))


def catalog_status_payload(units):
    state = load_state()
    managed = state.get("entries", {})
    entries = []
    for unit in units:
        managed_state = managed.get(unit["id"])
        if unit.get("executable"):
            executable = unit["executable"]
            try:
                available = bool(normalize_executable_path(executable, require_exists=True))
            except LoadshedError:
                available = False
            processes = find_processes(executable) if available else []
            managed_active = bool(state.get("paused") and managed_state is not None)
            process_active = bool(processes)
            entries.append({
                "id": unit["id"],
                "label": unit["label"],
                "executable": executable,
                "optional": unit.get("optional", False),
                "available": available,
                "process_active": process_active,
                "process_count": len(processes),
                "managed": managed_active,
                "recommended_enabled": managed_active or process_active,
            })
            continue

        service_status = show_unit(unit["service"])
        timer_status = show_unit(unit["timer"]) if unit.get("timer") else {}
        service_loaded = unit_loaded(service_status)
        timer_loaded = unit_loaded(timer_status) if unit.get("timer") else False
        service_active = service_status.get("ActiveState") in ("active", "activating")
        timer_active = timer_status.get("ActiveState") == "active"
        managed_state = managed_state or {}
        managed_active = bool(
            entry_owns_service_freeze(managed_state) or
            managed_state.get("timer_stopped") or
            managed_state.get("timer_stop_pending")
        )
        available = service_loaded and (not unit.get("timer") or timer_loaded)

        entries.append({
            "id": unit["id"],
            "label": unit["label"],
            "service": unit["service"],
            "timer": unit.get("timer"),
            "optional": unit.get("optional", False),
            "available": available,
            "service_load_state": service_status.get("LoadState"),
            "service_active_state": service_status.get("ActiveState"),
            "service_active": service_active,
            "timer_load_state": timer_status.get("LoadState"),
            "timer_active_state": timer_status.get("ActiveState"),
            "timer_active": timer_active,
            "managed": managed_active,
            "recommended_enabled": available and (managed_active or service_active or timer_active),
        })

    return {
        "ok": True,
        "action": "catalog-status",
        "entries": entries,
        "errors": [],
    }


def cgroup_file_from_status(status, filename):
    control_group = status.get("ControlGroup")
    if not isinstance(control_group, str) or not control_group.startswith("/"):
        raise LoadshedError("unit control group is not available")

    rel_path = control_group.lstrip("/")
    cgroup_path = os.path.normpath(os.path.join(CGROUP_ROOT, rel_path))
    cgroup_root = os.path.normpath(CGROUP_ROOT)
    if cgroup_path == cgroup_root or not cgroup_path.startswith(f"{cgroup_root}/"):
        raise LoadshedError(f"refusing unexpected control group: {control_group}")

    return os.path.join(cgroup_path, filename)


def cgroup_frozen_from_status(status):
    try:
        events_path = cgroup_file_from_status(status, "cgroup.events")
    except LoadshedError:
        return False

    try:
        with open(events_path, "r", encoding="utf-8") as events_file:
            for line in events_file:
                key, _, value = line.strip().partition(" ")
                if key == "frozen":
                    return value == "1"
    except OSError:
        return False

    return False


def set_cgroup_freeze(unit, frozen):
    status = show_unit(unit, include_freezer=True, extra_properties=["ControlGroup"])
    freeze_path = cgroup_file_from_status(status, "cgroup.freeze")
    requested = "1" if frozen else "0"

    try:
        with open(freeze_path, "w", encoding="utf-8") as freeze_file:
            freeze_file.write(f"{requested}\n")
    except OSError as exc:
        action = "freeze" if frozen else "thaw"
        raise LoadshedError(f"cgroup {action} failed for {unit}: {exc}") from exc

    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        if cgroup_frozen_from_status(status) == frozen:
            return
        time.sleep(0.05)

    action = "freeze" if frozen else "thaw"
    raise LoadshedError(f"cgroup {action} timed out for {unit}")


def service_frozen_from_status(status):
    return (
        status.get("FreezerState") == "frozen" or
        cgroup_frozen_from_status(status)
    )


def service_freeze_state_known(status):
    return (
        unit_loaded(status) and
        (status.get("FreezerState") in {"running", "frozen"} or
         isinstance(status.get("ControlGroup"), str))
    )


def freeze_service(unit):
    result = systemctl(["freeze", unit])
    if result.returncode == 0:
        status = show_unit(unit, include_freezer=True, extra_properties=["ControlGroup"])
        if not service_freeze_state_known(status):
            raise LoadshedError(f"could not verify freezer state after freezing {unit}")
        if not service_frozen_from_status(status):
            raise LoadshedError(f"systemctl freeze {unit} returned success but the cgroup is running")
        return "systemctl"

    detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
    try:
        set_cgroup_freeze(unit, True)
    except LoadshedError as exc:
        raise LoadshedError(
            f"systemctl freeze {unit} failed: {detail}; fallback {exc}"
        ) from exc

    status = show_unit(unit, include_freezer=True, extra_properties=["ControlGroup"])
    if not service_freeze_state_known(status):
        raise LoadshedError(f"could not verify freezer state after freezing {unit}")
    if not service_frozen_from_status(status):
        raise LoadshedError(f"cgroup freeze {unit} was not observed")
    return "cgroup"


def thaw_service(unit, method):
    if method == "cgroup":
        set_cgroup_freeze(unit, False)
        return

    systemctl(["thaw", unit], check=True)


def verify_service_thawed(unit):
    status = show_unit(unit, include_freezer=True, extra_properties=["ControlGroup"])
    if not service_freeze_state_known(status):
        raise LoadshedError(f"could not verify freezer state after thawing {unit}")
    if service_frozen_from_status(status):
        raise LoadshedError(f"service remained frozen after thaw: {unit}")


def entry_owns_service_freeze(entry_state):
    # service_frozen is the field used by releases before the durable state
    # format.  Treat it as owned while migrating old state.
    return bool(entry_state.get("owned_frozen", entry_state.get("service_frozen")))


def proc_stat_start_time(pid):
    try:
        stat_text = PathLikeProc(pid, "stat").read_text()
    except OSError:
        return None

    parts = stat_text.rsplit(") ", 1)
    if len(parts) != 2:
        return None
    fields = parts[1].split()
    if len(fields) < 20:
        return None
    return fields[19]


class PathLikeProc:
    def __init__(self, pid, name):
        self.path = os.path.join("/proc", str(pid), name)

    def read_text(self):
        with open(self.path, "r", encoding="utf-8", errors="replace") as proc_file:
            return proc_file.read()


def proc_comm(pid):
    try:
        return PathLikeProc(pid, "comm").read_text().strip()
    except OSError:
        return None


def proc_executable(pid):
    try:
        target = os.readlink(os.path.join("/proc", str(pid), "exe"))
    except OSError:
        return None
    if target.endswith(" (deleted)"):
        # The kernel appends this when the inode a running process is
        # executing from was unlinked -- typically a package upgrade
        # replacing the binary in place while the process is still up.
        # Strip it and keep matching by the original path, the same way
        # tools/loadshed-gate strips it from fanotify event paths.
        # Otherwise a running process silently becomes untrackable the
        # moment its backing binary is upgraded.
        target = target[: -len(" (deleted)")]
    return normalize_executable_path(target)


def proc_state(pid):
    try:
        status = PathLikeProc(pid, "status").read_text()
    except OSError:
        return None
    for line in status.splitlines():
        if line.startswith("State:"):
            parts = line.split()
            return parts[1] if len(parts) > 1 else None
    return None


def find_processes(executable):
    executable = normalize_executable_path(executable)
    matches = []
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        if pid == os.getpid():
            continue
        if proc_executable(pid) != executable:
            continue
        start_time = proc_stat_start_time(pid)
        if start_time is None:
            continue
        matches.append({
            "pid": pid,
            "start_time": start_time,
            "state": proc_state(pid),
        })
    return matches


def process_is_same(pid, executable, start_time):
    return (
        proc_executable(pid) == normalize_executable_path(executable) and
        proc_stat_start_time(pid) == start_time
    )


def stop_process(pid, executable, start_time):
    if process_is_same(pid, executable, start_time):
        os.kill(pid, signal.SIGSTOP)


def continue_process(pid, executable, start_time):
    if process_is_same(pid, executable, start_time):
        os.kill(pid, signal.SIGCONT)


def verify_process_continued(pid, executable, start_time):
    if not process_is_same(pid, executable, start_time):
        return
    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        if proc_state(pid) != "T":
            return
        time.sleep(0.05)
    raise LoadshedError(f"process remained stopped after resume: {pid}")


def pause_process(unit, entry_state, errors, persist=None):
    executable = unit["executable"]
    processes = {
        str(pid): proc
        for pid, proc in (entry_state.get("processes") or {}).items()
        if process_is_same(int(pid), executable, str(proc.get("start_time")))
    }

    for proc in find_processes(executable):
        pid_key = str(proc["pid"])
        if proc.get("state") != "T":
            try:
                stop_process(proc["pid"], executable, proc["start_time"])
            except OSError as exc:
                errors.append(f"{unit['label']}: failed to stop pid {proc['pid']}: {exc}")
                continue
        processes[pid_key] = {
            "start_time": proc["start_time"],
            "executable": executable,
        }
        entry_state["executable"] = executable
        entry_state["processes"] = processes
        entry_state["process_stopped"] = bool(processes)
        if persist is not None:
            persist(entry_state)

    entry_state["executable"] = executable
    entry_state["processes"] = processes
    entry_state["process_stopped"] = bool(processes)
    return entry_state


def pause_units(units, new_pause=True):
    state = load_state()
    if not state.get("state_known", True):
        raise LoadshedError(state.get("state_error") or "Loadshed state requires recovery")
    entries = state.setdefault("entries", {})
    errors = []

    if new_pause or not state.get("paused"):
        state["paused"] = True
        state["intent"] = "pausing"
        state["generation"] = int(state.get("generation", 0)) + 1
        state["recovery_required"] = False
        save_state(state)
    else:
        state["paused"] = True
        state["intent"] = "pausing"
        save_state(state)

    try:
        gate = gate_configure(units, state["generation"])
        state["gate"] = gate
    except LoadshedError as exc:
        # A gate failure must not stop the actual pause: SIGSTOP/freeze below
        # is what protects the system.  Record the failure and degrade to a
        # non-strict pause (status_payload reports pause_intent without
        # paused) instead of leaving nothing paused at all.
        state["gate"] = {"healthy": False, "active": False, "error": str(exc)}
        errors.append(str(exc))
    save_state(state)

    for unit in units:
        if optional_service_missing(unit, entries.get(unit["id"])):
            continue

        if unit.get("executable"):
            entry_state = entries.get(unit["id"], {
                "executable": unit["executable"],
                "process_stopped": False,
                "processes": {},
            })
            def persist_process_entry(value):
                entries[unit["id"]] = value
                save_state(state)

            entry_state = pause_process(unit, entry_state, errors, persist_process_entry)
            # Keep the entry even when no process exists.  It is the durable
            # pause intent that lets the gate catch a future direct exec.
            entries[unit["id"]] = entry_state
            save_state(state)
            continue

        entry_state = entries.get(unit["id"], {
            "service": unit["service"],
            "timer": unit.get("timer"),
            "owned_frozen": False,
            "service_frozen": False,
            "timer_stopped": False,
        })
        if "owned_frozen" not in entry_state:
            entry_state["owned_frozen"] = entry_owns_service_freeze(entry_state)

        try:
            timer = unit.get("timer")
            if timer:
                timer_status = show_unit(timer)
                if not unit_loaded(timer_status) and not unit.get("optional"):
                    raise LoadshedError(f"timer not loaded: {timer}")
                if unit_loaded(timer_status) and timer_status["ActiveState"] == "active":
                    # Journal the intent before the stop.  If the helper is
                    # interrupted after systemctl has acted but before the
                    # completed entry is persisted, resume still knows that
                    # this timer must be started again.
                    entry_state["timer_stop_pending"] = True
                    entries[unit["id"]] = entry_state
                    save_state(state)
                    systemctl(["stop", timer], check=True)
                    entry_state["timer_stopped"] = True
                    entry_state.pop("timer_stop_pending", None)
                    entries[unit["id"]] = entry_state
                    save_state(state)

            service_status = show_unit(unit["service"], include_freezer=True, extra_properties=["ControlGroup"])
            if not unit_loaded(service_status):
                if unit.get("optional"):
                    continue
                raise LoadshedError(f"service not loaded: {unit['service']}")

            service_active = service_status["ActiveState"] in ("active", "activating")
            service_frozen = service_frozen_from_status(service_status)
            entry_state["control_group"] = service_status.get("ControlGroup")

            if service_frozen:
                if entry_owns_service_freeze(entry_state):
                    entry_state["owned_frozen"] = True
                    entry_state["service_frozen"] = True
                else:
                    # Do not claim or thaw a cgroup that was already frozen
                    # before this pause.  The explicit recovery action is
                    # required when ownership cannot be proven anymore.
                    entry_state["owned_frozen"] = False
                    entry_state["service_frozen"] = False
                    entry_state["preexisting_frozen"] = True
                    entry_state.pop("freeze_method", None)
            elif service_active:
                entry_state["freeze_method"] = freeze_service(unit["service"])
                entry_state["owned_frozen"] = True
                entry_state["service_frozen"] = True
                entry_state.pop("preexisting_frozen", None)
            elif not service_frozen and entry_owns_service_freeze(entry_state):
                entry_state["owned_frozen"] = False
                entry_state["service_frozen"] = False
                entry_state.pop("freeze_method", None)
        except LoadshedError as exc:
            errors.append(f"{unit['label']}: {exc}")
            if unit.get("service"):
                try:
                    failed_status = show_unit(
                        unit["service"],
                        include_freezer=True,
                        extra_properties=["ControlGroup"],
                    )
                    if unit_loaded(failed_status) and service_frozen_from_status(failed_status):
                        entry_state["owned_frozen"] = True
                        entry_state["service_frozen"] = True
                        entry_state["control_group"] = failed_status.get("ControlGroup")
                        state["recovery_required"] = True
                except LoadshedError:
                    pass

        if (
            entry_state.get("owned_frozen") or
            entry_state.get("service_frozen") or
            entry_state.get("timer_stopped") or
            entry_state.get("timer_stop_pending") or
            entry_state.get("preexisting_frozen")
        ):
            entries[unit["id"]] = entry_state
        else:
            entries.pop(unit["id"], None)
        save_state(state)

    state["intent"] = "paused"
    state["recovery_required"] = bool(errors)
    save_state(state)
    return errors


def enforce_units(units):
    state = load_state()
    if not state.get("state_known", True):
        return [state.get("state_error") or "Loadshed state requires recovery"]
    if not state.get("paused"):
        return []
    return pause_units(units, new_pause=False)


def units_by_id(units):
    return {unit["id"]: unit for unit in units}


def state_unit_from_entry(entry_id, entry_state, configured):
    configured_unit = configured.get(entry_id, {})
    executable = entry_state.get("executable", configured_unit.get("executable"))
    if executable is None and entry_state.get("process") is not None:
        executable = resolve_legacy_process(entry_state["process"])
    if executable is not None:
        executable = normalize_executable_path(executable)
        return {
            "id": entry_id,
            "label": configured_unit.get("label", entry_id),
            "executable": executable,
            "optional": configured_unit.get("optional", False),
            "enabled": configured_unit.get("enabled", True),
        }

    service = entry_state.get("service", configured_unit.get("service"))
    service = validate_unit_name(service, ".service")
    timer = entry_state.get("timer", configured_unit.get("timer"))
    if timer is not None:
        timer = validate_unit_name(timer, ".timer")

    return {
        "id": entry_id,
        "label": configured_unit.get("label", entry_id),
        "service": service,
        "timer": timer,
        "optional": configured_unit.get("optional", False),
        "enabled": configured_unit.get("enabled", True),
    }


def _service_entry_from_status(unit, status):
    return {
        "service": unit["service"],
        "timer": unit.get("timer"),
        "control_group": status.get("ControlGroup"),
        "owned_frozen": True,
        "service_frozen": True,
        "freeze_method": "systemctl",
        "timer_stopped": False,
        "recovery_adopted": True,
    }


def _process_entry_from_stopped(unit, processes):
    stopped = [proc for proc in processes if proc.get("state") == "T"]
    return {
        "executable": unit["executable"],
        "processes": {
            str(proc["pid"]): {
                "start_time": proc["start_time"],
                "executable": unit["executable"],
            }
            for proc in stopped
        },
        "process_stopped": bool(stopped),
        "recovery_adopted": True,
    }


def adopt_gate_recovery(state, units, gate):
    """Rebuild only configured freezes while the root gate proves a pause."""
    if not gate.get("active"):
        return False
    if state.get("state_known", True) and state.get("entries") and state.get("paused"):
        return False

    entries = state.setdefault("entries", {})
    gate_executables = {
        target.get("executable")
        for target in gate.get("targets", [])
        if isinstance(target, dict) and isinstance(target.get("executable"), str)
    }
    for unit in units:
        if unit.get("executable"):
            executable = normalize_executable_path(unit["executable"])
            if executable not in gate_executables or not os.path.exists(executable):
                continue
            entries[unit["id"]] = _process_entry_from_stopped(
                {**unit, "executable": executable}, find_processes(executable)
            )
            continue

        status = show_unit(unit["service"], include_freezer=True, extra_properties=["ControlGroup"])
        if unit_loaded(status) and service_frozen_from_status(status):
            entries[unit["id"]] = _service_entry_from_status(unit, status)

    state["state_known"] = True
    state["state_error"] = None
    state["paused"] = True
    state["intent"] = "resuming"
    gate_generation = gate.get("generation")
    state["generation"] = gate_generation if gate_generation is not None else state.get("generation", 0)
    state["recovery_required"] = True
    save_state(state)
    return True


def adopt_external_freezes(state, units):
    """Explicit recovery for orphaned configured freezes with no active gate."""
    entries = state.setdefault("entries", {})
    adopted = []
    for unit in units:
        existing = entries.get(unit["id"], {})
        if unit.get("executable"):
            if existing.get("process_stopped"):
                continue
            if not os.path.exists(unit["executable"]):
                continue
            processes = [
                proc for proc in find_processes(unit["executable"])
                if proc.get("state") == "T"
            ]
            if processes:
                entries[unit["id"]] = _process_entry_from_stopped(unit, processes)
                adopted.append(unit["id"])
            continue

        if entry_owns_service_freeze(existing):
            continue
        status = show_unit(unit["service"], include_freezer=True, extra_properties=["ControlGroup"])
        if unit_loaded(status) and service_frozen_from_status(status):
            entries[unit["id"]] = _service_entry_from_status(unit, status)
            adopted.append(unit["id"])

    state["state_known"] = True
    state["state_error"] = None
    state["paused"] = bool(adopted)
    state["intent"] = "resuming" if adopted else "idle"
    state["recovery_required"] = bool(adopted)
    save_state(state)
    return adopted


def recover_units(units):
    state = load_state()
    gate = gate_status()
    if gate.get("active"):
        adopt_external_freezes(state, units)
        return resume_units(units)
    adopted = adopt_external_freezes(state, units)
    if not adopted and not state.get("paused") and not state.get("entries"):
        return []
    return resume_units(units)


def resume_units(units, entry_ids=None):
    state = load_state()
    gate = gate_status()
    if state.get("state_known", True) is False:
        if not adopt_gate_recovery(state, units, gate):
            return [state.get("state_error") or "Loadshed state requires recovery"]
    elif gate.get("active") and (not state.get("paused") or not state.get("entries")):
        adopt_gate_recovery(state, units, gate)

    entries = state.get("entries", {})
    configured = units_by_id(units)
    selected_ids = set(entries) if entry_ids is None else set(entry_ids)
    full_resume = entry_ids is None
    # Keep unprocessed selected entries in the journal as well.  If the
    # helper is interrupted halfway through a resume, the next invocation
    # must still see every target that has not been verified yet.
    remaining = dict(entries)
    errors = []

    for entry_id, entry_state in entries.items():
        if entry_id not in selected_ids:
            continue

        try:
            unit = state_unit_from_entry(entry_id, entry_state, configured)
        except LoadshedError as exc:
            errors.append(f"{entry_id}: {exc}")
            remaining[entry_id] = entry_state
            continue

        keep_state = dict(entry_state)
        if keep_state.get("process_stopped"):
            executable = unit.get("executable")
            if executable:
                kept_processes = {}
                for pid, proc in (entry_state.get("processes") or {}).items():
                    try:
                        continue_process(int(pid), executable, str(proc.get("start_time")))
                        verify_process_continued(int(pid), executable, str(proc.get("start_time")))
                    except OSError as exc:
                        if exc.errno != errno.ESRCH:
                            errors.append(f"{unit['label']}: process resume failed for {pid}: {exc}")
                            kept_processes[pid] = proc
                    except LoadshedError as exc:
                        errors.append(f"{unit['label']}: {exc}")
                        kept_processes[pid] = proc
                keep_state["processes"] = kept_processes
                keep_state["process_stopped"] = bool(kept_processes)

        if entry_owns_service_freeze(entry_state):
            try:
                service_status = show_unit(unit["service"], include_freezer=True, extra_properties=["ControlGroup"])
                service_frozen = service_frozen_from_status(service_status)
                if service_frozen:
                    thaw_service(unit["service"], entry_state.get("freeze_method"))
                    verify_service_thawed(unit["service"])
                keep_state["owned_frozen"] = False
                keep_state["service_frozen"] = False
                keep_state.pop("freeze_method", None)
            except LoadshedError as exc:
                errors.append(f"{unit['label']}: {exc}")
        else:
            # A pre-existing/external freeze is intentionally not changed by
            # normal resume.  It remains visible as external_frozen.
            keep_state.pop("preexisting_frozen", None)

        if (
            (entry_state.get("timer_stopped") or entry_state.get("timer_stop_pending"))
            and unit.get("timer")
        ):
            try:
                systemctl(["start", unit["timer"]], check=True)
                keep_state["timer_stopped"] = False
                keep_state.pop("timer_stop_pending", None)
            except LoadshedError as exc:
                errors.append(f"{unit['label']}: {exc}")

        if (
            entry_owns_service_freeze(keep_state) or
            keep_state.get("timer_stopped") or
            keep_state.get("timer_stop_pending")
        ):
            remaining[entry_id] = keep_state
        elif keep_state.get("process_stopped"):
            remaining[entry_id] = keep_state
        else:
            remaining.pop(entry_id, None)
        state["entries"] = remaining
        save_state(state)

    state["entries"] = remaining
    state["intent"] = "paused" if not full_resume and not errors else "resuming"
    save_state(state)

    if full_resume and not remaining:
        try:
            gate = gate_release(state.get("generation", 0))
            state["paused"] = False
            state["intent"] = "idle"
            state["recovery_required"] = False
            state["gate"] = gate
            save_state(state)
        except LoadshedError as exc:
            errors.append(str(exc))
            state["paused"] = True
            state["intent"] = "resuming"
            state["recovery_required"] = True
            state["gate"] = {"healthy": False, "active": True, "error": str(exc)}
            save_state(state)
    elif errors:
        state["paused"] = True
        state["intent"] = "resuming"
        state["recovery_required"] = True
        save_state(state)
    return errors


def reconcile_config_state(old_units, new_units):
    state_entries = load_state().get("entries", {})
    if not state_entries:
        return []

    new_by_id = units_by_id(new_units)
    stale_ids = []
    for entry_id, entry_state in state_entries.items():
        new_unit = new_by_id.get(entry_id)
        if not new_unit or not unit_enabled(new_unit):
            stale_ids.append(entry_id)
            continue

        if (
            entry_state.get("service") != new_unit.get("service") or
            entry_state.get("executable") != new_unit.get("executable") or
            entry_state.get("timer") != new_unit.get("timer")
        ):
            stale_ids.append(entry_id)

    if not stale_ids:
        return []

    return resume_units(old_units, stale_ids)


def status_payload(units, action, errors=None):
    state = load_state()
    managed = state.get("entries", {})
    configured = units_by_id(units)
    active_units = enabled_units(units)
    gate = gate_status()
    entries = []
    seen = set()

    for unit in active_units:
        managed_state = managed.get(unit["id"])
        if optional_service_missing(unit, managed_state):
            continue
        status_unit = state_unit_from_entry(unit["id"], managed_state, configured) if managed_state else unit
        status_state = dict(managed_state or {})
        status_state["pause_intent"] = state.get("paused")
        status_state["gate_active"] = gate["active"]
        entries.append(status_entry(status_unit, status_state))
        seen.add(unit["id"])

    for entry_id, entry_state in managed.items():
        if entry_id in seen:
            continue
        try:
            unit = state_unit_from_entry(entry_id, entry_state, configured)
            status_state = dict(entry_state)
            status_state["pause_intent"] = state.get("paused")
            status_state["gate_active"] = gate["active"]
            entries.append(status_entry(unit, status_state))
        except LoadshedError as exc:
            entries.append({
                "id": entry_id,
                "label": entry_id,
                "service": entry_state.get("service", ""),
                "timer": entry_state.get("timer"),
                "managed": True,
                "paused": False,
                "protected": False,
                "error": str(exc),
            })

    paused_count = sum(1 for entry in entries if entry.get("paused"))
    running_count = sum(
        1 for entry in entries
        if entry.get("service_active") and not entry.get("paused") and not entry.get("external_frozen")
    )
    protected_count = sum(1 for entry in entries if entry.get("protected"))
    external_frozen_count = sum(1 for entry in entries if entry.get("external_frozen"))
    intent = state.get("intent")
    if intent not in {"idle", "pausing", "paused", "resuming"}:
        intent = "paused" if state.get("paused") else "idle"
    errors = list(errors or [])
    state_present = state.get("state_present", True)
    pause_state_known = bool(
        state.get("state_known", True) and
        (state_present or (gate["healthy"] and not gate["active"]))
    )
    if not state.get("state_known", True):
        errors.append(state.get("state_error") or "Loadshed state requires recovery")
    elif not state_present and not pause_state_known:
        errors.append("Loadshed state journal is missing while gate state is not provably idle")
    if state.get("recovery_required") and state.get("state_known", True):
        errors.append("Loadshed recovery is required before normal operation")
    if intent in {"pausing", "resuming"}:
        errors.append("Loadshed transition is still pending")
    if external_frozen_count:
        errors.append("configured targets have external freezes; explicit recovery is required")
    if not gate["healthy"]:
        errors.append(gate["error"] or "loadshed-gate is unhealthy")
    elif state.get("paused") and not gate["active"]:
        errors.append("loadshed-gate is inactive while a pause intent is active")
    elif gate["active"] and not state.get("paused"):
        errors.append("loadshed-gate is active while no pause intent is recorded")
    generation_matches = (
        gate.get("generation") is None or
        gate.get("generation") == state.get("generation")
    )
    if state.get("paused") and not generation_matches:
        errors.append(
            f"loadshed-gate generation mismatch: gate={gate.get('generation')}, "
            f"state={state.get('generation')}"
        )
    strict_paused = bool(
        state.get("paused") and pause_state_known and
        intent == "paused" and not state.get("recovery_required") and
        external_frozen_count == 0 and
        gate["healthy"] and gate["active"] and generation_matches
    )
    recovery_required = bool(
        state.get("recovery_required") or
        not pause_state_known or
        intent in {"pausing", "resuming"} or
        external_frozen_count > 0 or
        (gate.get("active") and not state.get("paused"))
    )

    return {
        "ok": not errors,
        "action": action,
        "paused": strict_paused,
        "pause_intent": bool(state.get("paused")),
        "pause_state_known": pause_state_known,
        "gate_healthy": gate["healthy"],
        "gate_active": gate["active"],
        "queued_exec_count": gate["queued_exec_count"],
        "gate_error": gate["error"],
        "state_error": state.get("state_error"),
        "recovery_required": recovery_required,
        "resume_pending": intent == "resuming",
        "paused_count": paused_count,
        "running_count": running_count,
        "protected_count": protected_count,
        "external_frozen_count": external_frozen_count,
        "entries": entries,
        "errors": errors,
    }


def status_entry(unit, managed_state):
    if unit.get("executable"):
        return process_status_entry(unit, managed_state)

    service_status = show_unit(unit["service"], include_freezer=True, extra_properties=["ControlGroup"])
    timer_status = show_unit(unit["timer"]) if unit.get("timer") else {}
    managed_state = managed_state or {}
    error = None
    if not unit_loaded(service_status):
        error = f"service not loaded: {unit['service']}"
    elif unit.get("timer") and not unit.get("optional") and not unit_loaded(timer_status):
        error = f"timer not loaded: {unit['timer']}"

    service_active = service_status["ActiveState"] in ("active", "activating")
    cgroup_frozen = cgroup_frozen_from_status(service_status)
    service_frozen = service_status.get("FreezerState") == "frozen" or cgroup_frozen
    timer_active = timer_status.get("ActiveState") in ("active", "activating")
    managed_service_frozen = entry_owns_service_freeze(managed_state)
    managed_timer_stopped = bool(
        managed_state.get("timer_stopped") or managed_state.get("timer_stop_pending")
    )
    service_pause_effective = managed_service_frozen and service_frozen
    timer_pause_effective = managed_timer_stopped and unit_loaded(timer_status) and not timer_active
    paused = service_pause_effective or timer_pause_effective
    managed = managed_service_frozen or managed_timer_stopped

    return {
        "id": unit["id"],
        "label": unit["label"],
        "service": unit["service"],
        "timer": unit.get("timer"),
        "optional": unit.get("optional", False),
        "service_load_state": service_status.get("LoadState"),
        "service_active_state": service_status.get("ActiveState"),
        "service_sub_state": service_status.get("SubState"),
        "service_freezer_state": service_status.get("FreezerState"),
        "service_cgroup_frozen": cgroup_frozen,
        "service_active": service_active,
        "service_frozen": service_frozen,
        "timer_active_state": timer_status.get("ActiveState"),
        "timer_sub_state": timer_status.get("SubState"),
        "timer_active": timer_active,
        "managed": managed,
        "paused": paused,
        "protected": False,
        "managed_service_frozen": managed_service_frozen,
        "managed_timer_stopped": managed_timer_stopped,
        "freeze_method": managed_state.get("freeze_method"),
        "freeze_owner": "loadshed" if service_pause_effective else ("external" if service_frozen else None),
        "external_frozen": service_frozen and not managed_service_frozen,
        "error": error,
    }


def process_status_entry(unit, managed_state):
    managed_state = managed_state or {}
    executable_exists = os.path.exists(unit["executable"])
    processes = find_processes(unit["executable"]) if executable_exists else []
    managed_processes = managed_state.get("processes") or {}
    stopped_processes = {
        pid: proc
        for pid, proc in managed_processes.items()
        if process_is_same(int(pid), unit["executable"], str(proc.get("start_time")))
    }
    running_processes = [proc for proc in processes if proc.get("state") != "T"]
    process_active = bool(running_processes)
    process_stopped = bool(stopped_processes)
    protected = executable_exists and bool(
        managed_state.get("pause_intent") and managed_state.get("gate_active")
    )
    paused = process_stopped

    return {
        "id": unit["id"],
        "label": unit["label"],
        "executable": unit["executable"],
        "optional": unit.get("optional", False),
        "process_active": process_active,
        "process_count": len(processes),
        "running_process_count": len(running_processes),
        "process_stopped": process_stopped,
        "service_active": process_active,
        "service_frozen": process_stopped,
        "protected": protected,
        "stopped_process_count": len(stopped_processes),
        "managed": bool(managed_state.get("process_stopped")) or protected,
        "paused": paused,
        "freeze_owner": "loadshed" if process_stopped else None,
        "managed_process_stopped": bool(managed_state.get("process_stopped")) and process_stopped,
        "error": None if executable_exists else f"executable not found: {unit['executable']}",
    }


def main():
    action = sys.argv[1] if len(sys.argv) == 2 else None
    valid_actions = {
        "status", "pause", "resume", "toggle", "enforce", "recover",
        "config-get", "config-set", "catalog-status",
    }
    if action not in valid_actions:
        return fail("usage: loadshed-helper status|pause|resume|toggle|enforce|recover|config-get|config-set|catalog-status")

    try:
        require_root()

        with helper_lock(shared=action in {"status", "catalog-status"}):
            if action == "config-get":
                json_print(config_payload(action, load_units()))
                return 0

            if action == "catalog-status":
                require_systemctl()
                raw_catalog = sys.stdin.read()
                units = validate_units(json.loads(raw_catalog)) if raw_catalog.strip() else load_units()
                json_print(catalog_status_payload(units))
                return 0

            if action == "config-set":
                raw_config = sys.stdin.read()
                if not raw_config.strip():
                    raise LoadshedError("empty configuration")
                old_units = load_units()
                units = validate_units(json.loads(raw_config))
                require_systemctl()
                current_state = load_state()
                if not current_state.get("state_known", True):
                    raise LoadshedError(
                        current_state.get("state_error") or
                        "Loadshed state requires recovery before configuration changes"
                    )
                was_paused = bool(current_state.get("paused"))
                errors = reconcile_config_state(old_units, units)
                if errors:
                    if was_paused:
                        errors.extend(pause_units(enabled_units(old_units), new_pause=False))
                    payload = config_payload(action, old_units)
                    payload["ok"] = False
                    payload["errors"] = errors
                    json_print(payload)
                    return 1

                save_units_config(units)
                if was_paused:
                    errors = pause_units(enabled_units(units), new_pause=False)

                payload = config_payload(action, units)
                payload["ok"] = not errors
                payload["errors"] = errors
                json_print(payload)
                return 0 if payload["ok"] else 1

            require_systemctl()
            units = load_units()
            active_units = enabled_units(units)

            errors = []
            if action == "pause":
                errors = pause_units(active_units)
            elif action == "resume":
                errors = resume_units(units)
            elif action == "enforce":
                errors = enforce_units(active_units)
            elif action == "recover":
                errors = recover_units(units)
            elif action == "toggle":
                if load_state().get("paused"):
                    errors = resume_units(units)
                    action = "resume"
                else:
                    errors = pause_units(active_units)
                    action = "pause"

            payload = status_payload(units, action, errors)
            json_print(payload)
            return 0 if payload["ok"] else 1
    except (OSError, json.JSONDecodeError, LoadshedError) as exc:
        return fail(str(exc), action=action)


if __name__ == "__main__":
    sys.exit(main())
